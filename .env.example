# Copy to .env.local and adjust.

# Backend base URL used when the operator has not saved one yet (localStorage "vide_backend_url").
NEXT_PUBLIC_DEFAULT_API_URL=http://127.0.0.1:8000/api

# true = serve a built-in fake fleet so every page works without the backend.
# Operators can also flip this at runtime from the SOURCE panel in the top bar.
NEXT_PUBLIC_USE_MOCKS=true

# Optional: proxy /api/* to the backend (see next.config.ts). If set, use NEXT_PUBLIC_DEFAULT_API_URL=/api
# API_PROXY_TARGET=http://127.0.0.1:8000
